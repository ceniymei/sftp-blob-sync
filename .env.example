# ==============================================================================
# Azure Blob Storage 配置
# ==============================================================================
# Azure 存储账户连接字符串 (可在 Azure Portal -> 存储账户 -> 访问密钥/Access keys 中获取)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account_name;AccountKey=your_account_key;EndpointSuffix=core.windows.net

# 目标 Blob 容器名称 (如果不存在，代码会自动创建)
AZURE_CONTAINER_NAME=my-target-container

# ==============================================================================
# SFTP 服务器 1 配置
# ==============================================================================
SFTP1_ENABLED=true
SFTP1_HOST=sftp1.example.com
SFTP1_PORT=22
SFTP1_USER=sftp_user_1
# 密码或私钥二选一（或同时使用），若使用私钥认证可留空密码
SFTP1_PASSWORD=your_password_1
SFTP1_KEY_FILE=
SFTP1_KEY_PASSPHRASE=
# SFTP 上的源目录路径（如 / 或 /data/upload）
SFTP1_REMOTE_DIR=/
# 上传到 Blob 容器中的前缀目录（以 / 结尾，例如 sftp1_data/）
SFTP1_BLOB_PREFIX=sftp1_data/

# ==============================================================================
# SFTP 服务器 2 配置（继续按 SFTP3_、SFTP4_ ... 追加即可，节点数量不限）
# ==============================================================================
SFTP2_ENABLED=true
SFTP2_HOST=sftp2.example.com
SFTP2_PORT=22
SFTP2_USER=sftp_user_2
# 密码或私钥二选一，若使用私钥认证可留空密码
SFTP2_PASSWORD=your_password_2
SFTP2_KEY_FILE=
SFTP2_KEY_PASSPHRASE=
# SFTP 上的源目录路径
SFTP2_REMOTE_DIR=/
# 上传到 Blob 容器中的前缀目录（以 / 结尾，例如 sftp2_data/）
SFTP2_BLOB_PREFIX=sftp2_data/

# ==============================================================================
# 同步策略与运行设置
# ==============================================================================
# 并发传输的文件数量 (建议 3-8，根据 SFTP 服务器承载能力和网络带宽调整)
MAX_CONCURRENT_FILES=5

# 是否直接覆盖目标文件 (true: 不检查直接覆盖，速度最快; false: 预先检查并跳过未变更文件)
OVERWRITE_EXISTING=true

# 复制成功后是否删除 SFTP 上的原文件 (true: 删除; false: 保留，默认安全推荐 false)
DELETE_AFTER_COPY=false

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ==============================================================================
# 传输性能调优（可选，留空即使用下方默认值）
# ==============================================================================
# 同时同步的 SFTP 节点数量。各节点互不相干，并行可成倍缩短总耗时。
# 注意：实际总并发 = MAX_CONCURRENT_SOURCES × MAX_CONCURRENT_FILES
MAX_CONCURRENT_SOURCES=2

# SSH channel 窗口大小 (MB)。单连接吞吐上限约等于 窗口 / RTT，
# paramiko 默认仅 2MB，跨洋链路(RTT 150-250ms)会被锁死在 10MB/s 左右。
SFTP_WINDOW_SIZE_MB=64

# 小于该阈值的文件一次性 PUT 上传，不走分块流程 (Azure SDK 默认 64)
AZURE_MAX_SINGLE_PUT_MB=16

# 分块上传的块大小 (MB)。Azure SDK 默认 4MB，高延迟链路下偏小
AZURE_MAX_BLOCK_MB=8

# Azure HTTP 连接池上限，应不小于 总并发文件数 × 4
AZURE_CONNECTION_POOL_SIZE=64
